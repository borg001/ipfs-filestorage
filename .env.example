# Server
SERVER_PORT=3000
STORAGE1_PORT=3001
STORAGE2_PORT=3002
NGINX_PORT=8081

# IPFS
IPFS_URL=http://ipfs1:5001
CLUSTER_NODES=http://ipfs1:5001,http://ipfs2:5001

# API Keys (optional static keys; leave empty to require Lua auth)
API_KEYS=

# Upload limits
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=png,svg,jpg,pdf,doc,docx,zip,json,html,txt,mp4,mov,webm,avi

# Image bundles
IMAGE_PROCESSING_ENABLED=true
IMAGE_VARIANTS=100x100,320x320,480x640,640x640,768x1024,1024x1024
IMAGE_OUTPUT_FORMAT=auto
IMAGE_JPEG_PROGRESSIVE=true
IMAGE_JPEG_QUALITY=82
IMAGE_WEBP_QUALITY=82
IMAGE_RESIZE_POLICY=smart-cover
# Privacy variants are always generated for raster images:
# /file/{cid}/blur and /file/{cid}/blur_faces.
IMAGE_BLUR_RADIUS=24
IMAGE_FACE_BLUR_RADIUS=16
IMAGE_FACE_DETECTION_MAX_DIMENSION=1280
IMAGE_FACE_DETECTION_SCORE_THRESHOLD=0.8
IMAGE_FACE_DETECTION_NMS_THRESHOLD=0.3

# Pinning
PINNING_RETRIES=3
PINNING_RETRY_DELAY_MS=1000

# Soft delete
UNPIN_TTL=24h
UNPIN_GC_INTERVAL=1h
UNPIN_STORE_PATH=/data/unpin-store.json

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,X-API-Key,Authorization

# Video
VIDEO_MAX_DURATION_SEC=2400
VIDEO_MAX_SIZE_MB=1024
VIDEO_ASPECT_RATIO_TOLERANCE=0.1
VIDEO_SEGMENT_DURATION_SEC=4
VIDEO_BITRATES=500k,1500k,4000k
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_TEMP_DIR=/tmp/video_processing
VIDEO_THUMBNAIL_VARIANTS=180x320,360x640,720x1280
VIDEO_THUMBNAIL_TIME_SEC=1.0
VIDEO_THUMBNAIL_QSCALE=3

# Lua Auth (optional, path to .lua script)
AUTH_LUA_SCRIPT=
AUTH_LUA_TIMEOUT_MS=3000
AUTH_LUA_ENV_WHITELIST=AUTH_SERVICE_URL

# Authenticated CID and placement policy endpoints. Storage forwards the
# caller's Bearer/query token. Empty/denied policy responses never allow bytes.
MEDIA_ACCESS_URL=
MEDIA_LINK_ACCESS_URL=
MEDIA_ACCESS_TIMEOUT_MS=2500
# Explicit opt-in ONLY for standalone deployments with no per-file ACLs.
# Missing or invalid policy configuration otherwise fails closed.
MEDIA_ALLOW_UNMANAGED=false

# Stage B: encrypted, session-bound download grants. Keep session Lua auth enabled.
# Same keyring, audience, namespace and noeviction Redis as API; keys are 32 bytes base64.
MEDIA_GRANTS_ENABLED=false
MEDIA_GRANT_ACTIVE_KEY=k1
MEDIA_GRANT_AUDIENCE=iamfree-local
MEDIA_GRANT_KEYS={}
MEDIA_GRANT_REDIS_URL=redis://redis:6379/0
MEDIA_GRANT_NAMESPACE=iamfree-local
