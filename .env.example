# IPFS File Storage — Environment Configuration
# Copy to .env and customize:
#   cp .env.example .env
# Then run: docker-compose up --build

# Server
SERVER_PORT=3000

# IPFS
IPFS_URL=http://localhost:5001
CLUSTER_NODES=http://ipfs1:5001,http://ipfs2:5001

# Auth
API_KEYS=SECRET_KEY_1,SECRET_KEY_2

# Upload limits
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=png,svg,jpg,pdf,doc,docx,zip,json,html

# Pinning
PINNING_RETRIES=3
PINNING_RETRY_DELAY_MS=1000

# Soft-delete TTL
UNPIN_TTL=24h
UNPIN_GC_INTERVAL=1h
UNPIN_STORE_PATH=/data/unpin-store.json

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,X-API-Key
